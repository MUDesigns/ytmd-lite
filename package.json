{
  "name": "ytmd-lite",
  "version": "0.4.1",
  "description": "Lightweight YouTube Music Desktop client (Tauri 2) with Last.fm",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:backend": "python -m unittest discover -s tests -p test_*.py",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "icon": "python scripts/make-icon.py && npx tauri icon app-icon.png",
    "backend:build": "python-backend\\\\build_backend.bat",
    "playback:setup": "python scripts/setup-playback.py"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MUDesigns/ytmd-lite.git"
  }
}
