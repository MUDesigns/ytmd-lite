{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTMD Lite",
  "version": "0.2.1",
  "identifier": "app.ytmdesktop.lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "lastfm.secrets.json",
      "../python-backend/server.py",
      "../python-backend/stream_resolver.py",
      "../python-backend/audio_proxy.py",
      "../python-backend/requirements.txt",
      "resources/potgen/server/**/*",
      "resources/playback-runtime.json",
      "resources/NODE-LICENSE",
      "resources/node.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwMkEzRjMxMzE1NEZGNzAKUldSdy8xUXhNVDhxSU5scHFLQ1dobHMrT2lKTGg5VSs3Q01ubmJLNjRack5RVmhEa0o0WU9wSkIK",
      "endpoints": [
        "https://github.com/MUDesigns/ytmd-lite/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
